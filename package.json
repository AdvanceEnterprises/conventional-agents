{
  "name": "conventional-agents",
  "version": "2.1.0",
  "private": true,
  "devDependencies": {
    "markdownlint-cli2": "0.13.0"
  },
  "scripts": {
    "lint:adrs": "markdownlint-cli2 \"docs/decisions/ADR-*.md\"",
    "lint:specs": "markdownlint-cli2 \"docs/specifications/FS-*.md\"",
    "lint:plans": "markdownlint-cli2 \"docs/change-plans/PLAN-*.md\"",
    "lint:workflows": "markdownlint-cli2 \"workflows/*.md\"",
    "lint:guidelines": "markdownlint-cli2 \"guidelines/**/*.md\"",
    "lint:skills": "markdownlint-cli2 \"skills/**/*.md\"",
    "lint:templates": "markdownlint-cli2 \"templates/**/*.md\"",
    "lint:integrations": "markdownlint-cli2 \"integrations/**/*.md\"",
    "lint:roles": "markdownlint-cli2 \"roles/*.md\"",
    "lint:runbooks": "markdownlint-cli2 \"runbooks/**/*.md\"",
    "lint:roots": "markdownlint-cli2 \"*.md\"",
    "lint:docs": "npm run -s lint:adrs && npm run -s lint:specs && npm run -s lint:plans && npm run -s lint:workflows && npm run -s lint:guidelines && npm run -s lint:skills && npm run -s lint:templates && npm run -s lint:integrations && npm run -s lint:roles && npm run -s lint:runbooks && npm run -s lint:roots",
    "new:adr": "bash scripts/new-adr.sh",
    "new:plan": "bash scripts/new-plan.sh",
    "github:submodule-init": "bash integrations/github/bin/gh-submodule-init.sh",
    "github:label-provision": "bash integrations/github/bin/gh-label-provision.sh",
    "github:board-audit": "bash integrations/github/bin/gh-board-audit.sh",
    "github:pr-claim-audit": "bash integrations/github/bin/gh-pr-claim-audit.sh",
    "sync:claude-skills": "bash integrations/runtimes/claude-code/bin/sync-skills.sh",
    "ca-runtime-audit": "bash integrations/runtimes/claude-code/bin/ca-runtime-audit.sh",
    "check:status": "bash scripts/check-status.sh",
    "check:freshness": "bash scripts/check-freshness.sh",
    "check:freshness:history": "bash scripts/check-freshness-history.sh --strict",
    "check:delivery": "bash scripts/check-delivery-status.sh",
    "check:run-batch": "bash scripts/check-run-batch.sh",
    "check:conformance": "bash scripts/check-conformance.sh",
    "check:pr-claims": "bash scripts/check-pr-claims.sh",
    "lint:cross-repo": "bash scripts/cross-repo-lint.sh",
    "validate": "bash scripts/run-validation.sh",
    "bench:run": "bash scripts/bench-run.sh",
    "test": "bash scripts/run-bats.sh"
  }
}
